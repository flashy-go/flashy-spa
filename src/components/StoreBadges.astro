---
// Par de badges de descarga: Google Play (app nativa) e iPhone (web app).
// Vive en un componente compartido para que la home y /descargar no se
// desincronicen — el requisito es que se vean idénticas en ambas.
//
// `location` sólo alimenta data-umami-event, para distinguir desde qué
// bloque se hizo clic. Se usan atributos de Umami en vez de `id` porque el
// componente se repite varias veces en la misma página.
interface Props {
  location?: string;
}
const { location = 'page' } = Astro.props;

const downloadUrl = process.env.PUBLIC_DOWNLOAD_URL ?? import.meta.env.PUBLIC_DOWNLOAD_URL ?? '#';
const iosWebUrl = process.env.PUBLIC_IOS_WEB_URL ?? import.meta.env.PUBLIC_IOS_WEB_URL ?? 'https://app.flashygo.com';
---

<a
  href={downloadUrl}
  target="_blank"
  rel="noreferrer"
  class="store-badge"
  data-umami-event={`download-google-play-${location}`}
>
  <span class="store-badge-icon">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" aria-hidden="true">
      <path d="M3.609 1.814c-.236.255-.375.619-.375 1.072v18.228c0 .453.14.817.375 1.072l.056.054 10.217-10.217v-.046L3.665 1.76l-.056.054z" fill="#4285F4"/>
      <path d="M17.288 15.43l-3.406-3.407v-.046l3.406-3.407.077.044 4.034 2.292c1.153.654 1.153 1.726 0 2.38l-4.034 2.292-.077.052z" fill="#FBBC04"/>
      <path d="M17.365 15.378L13.882 11.977 3.609 22.186c.38.402.999.452 1.697.05l12.059-6.858" fill="#EA4335"/>
      <path d="M17.365 8.576L5.306 1.764c-.698-.402-1.317-.352-1.697.05l10.273 10.163 3.483-3.401z" fill="#34A853"/>
    </svg>
  </span>
  <span class="store-badge-text">
    <span class="store-badge-label">DISPONIBLE EN</span>
    <span class="store-badge-name">Google Play</span>
  </span>
</a>

<a
  href={iosWebUrl}
  class="store-badge"
  data-umami-event={`download-ios-web-${location}`}
>
  <span class="store-badge-icon">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="white" aria-hidden="true">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
    </svg>
  </span>
  <span class="store-badge-text">
    <span class="store-badge-label">ÚSALA EN LA WEB</span>
    <span class="store-badge-name">iPhone</span>
  </span>
</a>

<style>
  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 12px 28px 12px 18px;
    background: #000;
    border: 1.5px solid rgba(255,255,255,0.25);
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
    overflow: hidden;
  }
  .store-badge::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.05), transparent);
    pointer-events: none;
  }
  .store-badge:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 48px rgba(255,106,13,0.25), 0 0 0 1px rgba(255,255,255,0.15);
    border-color: rgba(255,255,255,0.4);
  }
  .store-badge:active { transform: translateY(0); }

  .store-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .store-badge-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
  }
  .store-badge-label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    line-height: 1;
  }
  .store-badge-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink);
  }

  @media (max-width: 600px) {
    .store-badge {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .store-badge { transition: none; }
    .store-badge:hover { transform: none; }
  }
</style>
