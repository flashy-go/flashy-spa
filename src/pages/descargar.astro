---
import UmamiAnalytics from '../components/UmamiAnalytics.astro';
import StoreBadges from '../components/StoreBadges.astro';

const iosWebUrl = process.env.PUBLIC_IOS_WEB_URL ?? import.meta.env.PUBLIC_IOS_WEB_URL ?? 'https://app.flashygo.com';

// En iPhone/iPad no hay app nativa todavía — mandamos a la web app.
// 302 (no 301) para poder revertirlo cuando salga la app de iOS.
const ua = Astro.request.headers.get('user-agent') ?? '';
const isIOS = /iPad|iPhone|iPod/i.test(ua) && !/Android/i.test(ua);
const isBot = /bot|crawler|spider|facebookexternalhit|slurp|preview/i.test(ua);
const optOut = Astro.url.searchParams.has('noredirect');

if (isIOS && !isBot && !optOut) {
  return Astro.redirect(iosWebUrl, 302);
}
---
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Descargar Flashy — La app de mototaxis y taxis de Puerto Cabello</title>
  <meta name="description" content="Descarga Flashy gratis en Google Play. La primera app de mototaxis y taxis de Puerto Cabello. Pide moto o carro: súbete y llega." />
  <link rel="canonical" href="https://flashygo.com/descargar" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#FF6A0D" />
  <link rel="icon" type="image/png" href="/flashy-favicon.png" />
  <!-- Open Graph -->
  <meta property="og:title" content="Descargar Flashy — App de mototaxis y taxis" />
  <meta property="og:description" content="Descarga Flashy gratis. La primera app de mototaxis y taxis de Puerto Cabello." />
  <meta property="og:image" content="https://flashygo.com/og-flashy.png" />
  <meta property="og:url" content="https://flashygo.com/descargar" />
  <meta property="og:type" content="website" />
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
  <!-- Umami Analytics -->
  <UmamiAnalytics />
</head>
<body>

<div class="dl-page">
  <!-- Background effects -->
  <div class="dl-grid-bg"></div>
  <div class="dl-glow dl-glow-1"></div>
  <div class="dl-glow dl-glow-2"></div>

  <!-- Floating speed lines -->
  <div class="dl-speedline" style="top:12%;animation-delay:0s;animation-duration:3s"></div>
  <div class="dl-speedline" style="top:28%;animation-delay:0.6s;animation-duration:3.4s"></div>
  <div class="dl-speedline" style="top:55%;animation-delay:1.2s;animation-duration:2.8s"></div>
  <div class="dl-speedline" style="top:72%;animation-delay:1.8s;animation-duration:3.2s"></div>
  <div class="dl-speedline" style="top:88%;animation-delay:0.3s;animation-duration:2.6s"></div>

  <!-- Floating particles -->
  <div class="dl-particle" style="top:18%;left:12%;animation-delay:0s"></div>
  <div class="dl-particle" style="top:72%;left:85%;animation-delay:1.2s"></div>
  <div class="dl-particle" style="top:35%;left:78%;animation-delay:2.4s"></div>
  <div class="dl-particle" style="top:85%;left:22%;animation-delay:0.8s"></div>
  <div class="dl-particle" style="top:45%;left:5%;animation-delay:1.6s"></div>

  <!-- Content -->
  <div class="dl-content">
    <!-- Logo -->
    <a href="/" class="dl-logo" aria-label="Ir al inicio">
      <img src="/flashy-word-logo.png" alt="Logo de Flashy" width="160" />
    </a>

    <!-- Badge -->
    <div class="dl-badge">
      <span class="dl-badge-dot"></span>
      DISPONIBLE EN PUERTO CABELLO
    </div>

    <!-- Title -->
    <h1 class="dl-title">
      <span>DESCARGA</span>
      <span class="dl-title-accent">FLASHY</span>
    </h1>

    <p class="dl-sub">
      Tu mototaxi o tu taxi en minutos. <strong>Tarifa clara, chofer verificado.</strong><br />
      Descarga la app y empieza a moverte.
    </p>

    <!-- Download buttons -->
    <div class="dl-buttons">
      <StoreBadges location="descargar" />
    </div>

    <!-- Back link -->
    <a href="/" class="dl-back">← Volver al inicio</a>
  </div>
</div>

<script is:inline define:vars={{ iosWebUrl }}>
  // iPadOS 13+ se reporta con user-agent de Macintosh, así que el chequeo
  // del servidor no lo detecta. Lo distinguimos por soporte táctil.
  if (!location.search.includes('noredirect') &&
      /Mac/.test(navigator.platform) && navigator.maxTouchPoints > 1) {
    location.replace(iosWebUrl);
  }
</script>

</body>
</html>

<style is:global>
  :root {
    --accent:      #FF6A0D;
    --accent-deep: #E8540A;
    --bg:          #0A0A0B;
    --bg-soft:     #111114;
    --ink:         #FAFAF7;
    --muted:       rgba(255,255,255,0.75);
    --border:      rgba(255,255,255,0.08);
    --font-body:   'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-display:'Outfit', sans-serif;
    --font-hero:   'Bebas Neue', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100%;
    overflow: hidden;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  ::selection { background: var(--accent); color: var(--bg); }

  /* ── Page container ── */
  .dl-page {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ── Background grid ── */
  .dl-grid-bg {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 70%);
  }

  /* ── Glows ── */
  .dl-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
  }
  .dl-glow-1 {
    top: -15%; left: 50%; transform: translateX(-50%);
    width: 800px; height: 800px;
    background: radial-gradient(circle, rgba(255,106,13,0.2), transparent 60%);
  }
  .dl-glow-2 {
    bottom: -25%; right: -10%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(255,106,13,0.08), transparent 55%);
  }

  /* ── Speed lines ── */
  @keyframes dl-speed {
    0%   { transform: translateX(-100%); opacity: 0; }
    30%  { opacity: 1; }
    100% { transform: translateX(120vw); opacity: 0; }
  }
  .dl-speedline {
    position: absolute; left: 0; width: 40%; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(255,106,13,0.4), transparent);
    animation: dl-speed 3s ease-in infinite;
  }

  /* ── Floating particles ── */
  @keyframes dl-float {
    0%, 100% { transform: translateY(0) scale(1); opacity: 0.3; }
    50%      { transform: translateY(-20px) scale(1.3); opacity: 0.6; }
  }
  .dl-particle {
    position: absolute;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--accent);
    pointer-events: none;
    animation: dl-float 4s ease-in-out infinite;
  }

  /* ── Content ── */
  .dl-content {
    position: relative; z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    padding: 24px;
    max-width: 640px;
  }

  /* ── Logo ── */
  .dl-logo {
    margin-bottom: 32px;
    transition: opacity 0.2s;
  }
  .dl-logo:hover { opacity: 0.8; }
  .dl-logo img { display: block; }

  /* ── Badge ── */
  @keyframes dl-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0.3; }
  }
  .dl-badge {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 9px 18px;
    border: 1px solid rgba(255,106,13,0.35);
    background: rgba(255,106,13,0.06);
    font-size: 10px; font-weight: 700; letter-spacing: 0.18em; color: var(--accent);
    margin-bottom: 24px;
  }
  .dl-badge-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    animation: dl-blink 1.5s steps(2) infinite;
  }

  /* ── Title ── */
  @keyframes dl-fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .dl-title {
    font-family: var(--font-hero);
    font-size: clamp(52px, 10vw, 130px);
    line-height: 0.85;
    letter-spacing: 0.02em;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: dl-fadeUp 0.8s ease-out both;
  }
  .dl-title-accent {
    color: var(--accent);
    animation: dl-fadeUp 0.8s ease-out 0.15s both;
  }

  /* ── Subtitle ── */
  .dl-sub {
    font-size: clamp(15px, 2vw, 18px);
    color: var(--muted);
    line-height: 1.6;
    max-width: 460px;
    margin: 0 0 36px;
    animation: dl-fadeUp 0.8s ease-out 0.3s both;
  }
  .dl-sub strong { color: var(--ink); font-weight: 600; }

  /* ── Buttons container ── */
  .dl-buttons {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 40px;
    animation: dl-fadeUp 0.8s ease-out 0.45s both;
  }

  /* Las badges de descarga viven en src/components/StoreBadges.astro
     (estilos scoped) para no desincronizarse con las de la home. */

  /* ── Back link ── */
  .dl-back {
    font-size: 13px;
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    letter-spacing: 0.04em;
    font-weight: 500;
    transition: color 0.2s;
    animation: dl-fadeUp 0.8s ease-out 0.6s both;
  }
  .dl-back:hover { color: var(--accent); }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .dl-logo img { width: 120px; }
    .dl-logo { margin-bottom: 24px; }

    .dl-title {
      font-size: clamp(44px, 14vw, 80px);
    }

    .dl-sub {
      font-size: 15px;
      margin-bottom: 28px;
    }

    .dl-buttons {
      flex-direction: column;
      gap: 12px;
      width: 100%;
      align-items: center;
    }

    .dl-content {
      padding: 20px;
    }
  }
</style>
